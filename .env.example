# Credenciales de TeleDrive (copia este archivo como .env y rellénalo).
# Se lee al arrancar: primero junto al ejecutable, luego en el directorio de trabajo.
# Lo que guardes desde la app tiene prioridad sobre estos valores.
#
# NO subas tu .env real a Git: está ignorado por .gitignore.

# my.telegram.org -> API development tools
TELEDRIVE_API_ID=
TELEDRIVE_API_HASH=

# turso db create mi-nube
# turso db show mi-nube --url
# turso db tokens create mi-nube
TELEDRIVE_TURSO_URL=
TELEDRIVE_TURSO_TOKEN=
